{
  "info": {
    "name": "Research Opportunity Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Create opportunity #1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning for Medical Imaging\",\n  \"description\": \"Research project: Deep Learning for Medical Imaging\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Sara Malik\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, PyTorch\",\n  \"positions\": 2,\n  \"deadline\": \"2026-12-20\",\n  \"status\": \"Open\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create opportunity #2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"IoT Smart Campus Sensors\",\n  \"description\": \"Research project: IoT Smart Campus Sensors\",\n  \"research_area\": \"Internet of Things\",\n  \"faculty_name\": \"Dr. Omar Farooq\",\n  \"department\": \"Electrical Engineering\",\n  \"required_skills\": \"C++, Arduino, MQTT\",\n  \"positions\": 3,\n  \"deadline\": \"2026-12-01\",\n  \"status\": \"Open\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create opportunity #3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Blockchain Voting Systems\",\n  \"description\": \"Research project: Blockchain Voting Systems\",\n  \"research_area\": \"Cybersecurity\",\n  \"faculty_name\": \"Dr. Hina Raza\",\n  \"department\": \"Software Engineering\",\n  \"required_skills\": \"Solidity, JavaScript\",\n  \"positions\": 1,\n  \"deadline\": \"2027-01-10\",\n  \"status\": \"Open\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get all opportunities",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get one opportunity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update opportunity",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Blockchain Voting Systems (Updated)\",\n  \"positions\": 4,\n  \"required_skills\": \"Solidity, JavaScript, React\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Change status Open -> Closed",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Closed\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Closed',()=>pm.expect(pm.response.json().status).to.eql('Closed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Delete opportunity",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Get deleted opportunity (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('404 Not Found',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Invalid data (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"positions\": -5,\n  \"deadline\": \"not-a-date\",\n  \"status\": \"Maybe\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}